# Copy file này thành .env rồi chỉnh theo môi trường. KHÔNG commit .env.

# URL web UI và API (cùng host)
BASE_URL=https://book.anhtester.com
API_BASE_URL=https://book.anhtester.com

# false = mở browser thật để debug (headed) · true = headless (CI)
HEADLESS=false

# Số luồng chạy song song — CHỈ đổi ở đây (hoặc WORKERS=2 npx playwright test)
WORKERS=5

# Timeout của một test (ms)
TIMEOUT=60000

# Mức log ghi vào reports/logs/test-execution.log: error | warn | info | debug
LOG_LEVEL=info

# Không cần khai tài khoản test: fixture tự đăng ký tài khoản unique cho mỗi worker/test
# qua POST /api/register — xem src/fixtures/api.fixture.ts

# ── Perfex CRM (crm.anhtester.com) — bộ TC docs/testcases/test_cases_login_web.md ──
# Tên biến theo đúng file TC. Để trống → test cần biến đó tự SKIP kèm lý do.
CRM_URL=https://crm.anhtester.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Tài khoản cổng khách hàng (TC_019, TC_020)
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
# Tài khoản staff có mật khẩu chứa chữ cái (TC_014)
TC014_EMAIL=
TC014_PASSWORD=
