{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Web UI + API automation framework cho AnhTester Book — Playwright TypeScript + Allure 2",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "cross-env HEADLESS=false playwright test --project=ui",
    "test:visual": "playwright test --ui",
    "test:debug": "cross-env HEADLESS=false playwright test --project=ui --debug",
    "test:smoke":"playwright test --grep @smoke",
    "test:account": "playwright test --grep @account",
    "test:no-account": "playwright test --grep-invert @account",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "report": "npm run report:generate && npm run report:open",
    "report:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "report:open": "allure open reports/allure-report",
    "report:single": "allure generate reports/allure-results -o reports/allure-report-single --single-file --clean",
    "report:html": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.0.0",
    "dotenv": "^18.0.4",
    "typescript": "^5.9.0",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=20"
  }
}
