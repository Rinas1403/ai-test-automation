# Sao chép thành .env rồi điền giá trị thật — .env đã được .gitignore chặn, KHÔNG commit
BASE_URL=https://crm.anhtester.com
TEST_USERNAME=
TEST_PASSWORD=

# false = mở browser thật (headed) khi debug · true = headless (mặc định, CI)
HEADLESS=true

# Số luồng chạy song song — chỗ DUY NHẤT để đổi (CI đặt riêng trong workflow)
WORKERS=5

# Timeout mỗi test (ms)
TIMEOUT=30000

# Mức log winston: error | warn | info | debug
LOG_LEVEL=info
