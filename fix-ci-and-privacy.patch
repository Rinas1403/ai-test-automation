-       "D5_asset_source": "Quỹ A"
-     },
-     "module_data": {
-       "module_1_partner": {
-         "partner_name": "auto_combo01_partner_1712049200",
-         "partner_type": "Tổ chức",
-         "tax_id": "0123456789",
-         "address": "Số 1 Nguyễn Huệ, Q1, HCM"
-       },
-       "module_2_payment": {
-         "currency": "VND",
-         "amount": 100000000,
-         "payment_date": "2026-04-15",
-         "description": "auto_combo01_payment_1712049200"
-       },
-       "module_3_tax": {
-         "tax_type": "VAT",
-         "tax_rate": 10,
-         "tax_amount": 10000000
-       },
-       "module_4_debt": {
